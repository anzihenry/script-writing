          "action": "承接沉默，门外终于回答来源。林夏仍拿着钥匙，盯着桌上纸片。",
          "dialogue": [
            {
              "id": "EP002-D001",
              "speaker_id": "CHAR002",
              "text": "楼梯口。都还你了，开门吧。",
              "mode": "off_screen"
            }
          ],
          "sound": [],
          "screen_text": []
        },
        {
          "id": "EP002-SC001-B002",
          "duration_seconds": 8,
          "action": "她把无刻字钥匙放在登记簿旁，手指压住纸片，只问索纸缘由，不提纸片出处。",
          "dialogue": [
            {
              "id": "EP002-D002",
              "speaker_id": "CHAR001",
              "text": "就一张纸，你急什么？",
              "mode": "on_screen"
            }
          ],
          "sound": [],
          "screen_text": []
        },
        {
          "id": "EP002-SC001-B003",
          "duration_seconds": 9,
          "action": "门外脱口索要登记簿里剩下的纸。林夏看向缺页，再转向始终关闭的不透明门。",
          "dialogue": [
            {
              "id": "EP002-D003",
              "speaker_id": "CHAR002",
              "text": "登记簿里剩下的，也给我。",
              "mode": "off_screen"
            }
          ],
          "sound": [],
          "screen_text": []
        },
        {
          "id": "EP002-SC001-B004",
          "duration_seconds": 8,
          "action": "她抬眼看不透明门，没有开门，也没有说出对方身份。",
          "dialogue": [],
          "sound": [],
          "screen_text": []
        },
        {
          "id": "EP002-SC001-B005",
          "duration_seconds": 9,
          "action": "她指出自己没有提过登记簿；说完停住，留出四秒等解释。",
          "dialogue": [
            {
              "id": "EP002-D004",
              "speaker_id": "CHAR001",
              "text": "我没提登记簿。你怎么知道？",
              "mode": "on_screen"
            }
          ],
          "sound": [],
          "screen_text": []
        },
        {
          "id": "EP002-SC001-B006",
          "duration_seconds": 10,
          "action": "对方撤回说法却再次索纸；林夏收拢纸片，不把撤回当作解释。",
          "dialogue": [
            {
              "id": "EP002-D005",
              "speaker_id": "CHAR002",
              "text": "我说错了。纸先给我。",
              "mode": "off_screen"
            }
